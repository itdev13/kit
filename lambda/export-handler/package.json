{
  "name": "convo-vault-export-lambda",
  "version": "1.0.0",
  "description": "Lambda function for ConvoVault background export processing",
  "main": "index.js",
  "scripts": {
    "zip": "zip -r function.zip index.js node_modules package.json",
    "deploy": "aws lambda update-function-code --function-name convo-vault-export --zip-file fileb://function.zip"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1004.0",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "axios": "^1.7.7",
    "docx": "^8.5.0",
    "mongodb": "^6.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
